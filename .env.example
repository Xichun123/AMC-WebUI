# API container
# Get your Gemini key at https://aistudio.google.com/apikey
# Optional. Leave empty for BYOK usage; set only for server-managed regular Gemini requests.
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com
# Optional, comma-separated. Leave empty for same-origin Docker usage.
ALLOWED_ORIGINS=

# Vertex AI backend (Stage 1: text chat + Imagen). Set GEMINI_BACKEND=vertex to enable.
# Requires GCP_PROJECT_ID and a Service Account JSON at ./secrets/sa.json on the host
# (mounted read-only into the api container at /run/secrets/).
# GCP_LOCATION defaults to us-central1. RUNTIME_BACKEND_FLAVOR must also be set to vertex
# so the frontend can drop browser BYOK assumptions.
GEMINI_BACKEND=aistudio
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# Vertex AI Files API → GCS adapter (Stage 2). Set GCS_BUCKET to enable file upload in vertex mode.
# The SA at GOOGLE_APPLICATION_CREDENTIALS must have roles/storage.objectUser on the bucket.
# Uploaded files land at gs://<GCS_BUCKET>/<GCS_OBJECT_PREFIX><uuid>. Frontend code is unchanged;
# the api server transparently rewrites generateContent fileUri references to gs:// URIs.
GCS_BUCKET=
GCS_OBJECT_PREFIX=amc-files/
GCS_MAX_FILE_BYTES=104857600

# Web container
WEB_PORT=8080

# Frontend runtime-config.js values injected at container startup
RUNTIME_SERVER_MANAGED_API=false
RUNTIME_USE_CUSTOM_API_CONFIG=true
RUNTIME_USE_API_PROXY=true
RUNTIME_API_PROXY_URL=/api/gemini
RUNTIME_PYODIDE_BASE_URL=
RUNTIME_BACKEND_FLAVOR=aistudio
